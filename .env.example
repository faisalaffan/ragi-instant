# PostgreSQL (geostack container)
PG_PASSWORD=geostack

# LLM Provider: openai | anthropic | deepseek
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (opsional, untuk Claude)
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek (opsional, OpenAI-compatible)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Generation model (tergantung provider)
# openai: gpt-4o-mini, gpt-4o
# anthropic: claude-3-5-haiku-latest
# deepseek: deepseek-chat, deepseek-reasoner
GENERATION_MODEL=gpt-4o-mini

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# Cohere
COHERE_API_KEY=...

# LangFuse (optional, kosongkan kalau tidak pakai)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# App
LOG_LEVEL=INFO
DATABASE_URL=postgresql://geostack:geostack@localhost:5432/ragi_instant
