# PostgreSQL (geostack container)
PG_PASSWORD=geostack

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (opsional, untuk Claude Haiku)
ANTHROPIC_API_KEY=sk-ant-...

# Cohere
COHERE_API_KEY=...

# Generation model: gpt-4o-mini | claude-haiku
GENERATION_MODEL=gpt-4o-mini

# LangFuse (optional, kosongkan kalau tidak pakai)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# App
LOG_LEVEL=INFO
